---
import { contact, site } from "../data/copy";
import { HoverLift } from "./react/HoverLift";
---

<section id="contact" class="bg-slate-950 text-white relative overflow-hidden" aria-labelledby="contact-heading">
  {/* Ambient gradient glowing backgrounds */}
  <div class="glow-spot-emerald -top-32 right-1/4 h-96 w-96 opacity-30"></div>
  <div class="glow-spot-indigo bottom-0 left-10 h-96 w-96 opacity-25"></div>

  <div class="shell section relative z-10">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-950/80 border border-emerald-500/30 px-3.5 py-1 text-xs font-mono font-semibold text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
          OPEN FOR COLLABORATION & RESEARCH
        </span>

        <h2
          id="contact-heading"
          class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight"
        >
          {contact.title}
        </h2>
        
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300 max-w-2xl">
          {contact.body}
        </p>
        
        <p class="mt-3 text-xs sm:text-sm text-slate-400 font-mono">
          {contact.note}
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col gap-4">
        <div class="rounded-[1.75rem] border border-slate-800 bg-slate-900/90 p-6 sm:p-7 backdrop-blur-xl shadow-2xl">
          <span class="text-xs font-mono uppercase text-slate-400">Direct Contact</span>
          
          <div class="mt-3 space-y-1">
            <div class="text-base font-bold text-white tracking-tight">
              {site.founder.name}
            </div>
            <div class="text-xs font-medium text-emerald-400 font-mono">
              {site.founder.role}
            </div>
            <div class="text-xs text-slate-300 font-mono select-all pt-1">
              {site.founder.email}
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-2.5">
            <HoverLift client:visible className="w-full">
              <a
                class="btn-primary w-full text-center text-sm"
                href={`mailto:${site.founder.email}`}
              >
                {contact.cta} →
              </a>
            </HoverLift>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
