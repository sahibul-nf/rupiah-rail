---
import { disclaimer } from "../data/copy";
---

<section class="border-t border-slate-200/80 bg-white" aria-labelledby="status-heading">
  <div class="shell py-12 sm:py-16">
    <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-6 sm:p-8 backdrop-blur-md">
      <div class="flex items-center gap-2 text-xs font-bold font-mono uppercase tracking-widest text-slate-500">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        <h2 id="status-heading">Current Project Status & Legal Notice</h2>
      </div>
      <p class="mt-3 max-w-4xl text-xs sm:text-sm leading-relaxed text-slate-600">
        {disclaimer}
      </p>
    </div>
  </div>
</section>
