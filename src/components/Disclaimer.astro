---
import { disclaimer } from "../data/copy";
---

<section class="border-t border-line" aria-labelledby="status-heading">
  <div class="shell py-12 sm:py-14">
    <div class="rounded-2xl border border-line bg-disclaimer px-6 py-6 sm:px-8">
      <h2 id="status-heading" class="text-sm font-semibold tracking-wide text-ink">
        Current status
      </h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-muted">{disclaimer}</p>
    </div>
  </div>
</section>
