---
import { hero } from "../data/copy";
import { HeroReveal } from "./react/HeroReveal";
import { HoverLift } from "./react/HoverLift";
import QuoteCard from "./QuoteCard.astro";
---

<section class="relative overflow-hidden" aria-labelledby="hero-heading">
  <div class="hero-wash" aria-hidden="true"></div>
  <div class="shell relative section pt-16 sm:pt-24">
    <HeroReveal client:load>
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:gap-16">
        <div>
          <p
            class="inline-flex rounded-full border border-line bg-accent-soft px-3 py-1 text-xs font-medium tracking-wide text-accent"
          >
            {hero.eyebrow}
          </p>
          <h1
            id="hero-heading"
            class="mt-6 max-w-xl text-[clamp(2rem,4.2vw,3.35rem)] font-semibold leading-[1.12] tracking-tight text-ink"
          >
            {hero.headline}
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-muted sm:text-[1.05rem]">
            {hero.supporting}
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <HoverLift client:load>
              <a class="btn-primary w-full sm:w-auto" href={hero.primaryHref}>
                {hero.primaryCta}
              </a>
            </HoverLift>
            <HoverLift client:load>
              <a class="btn-secondary w-full sm:w-auto" href={hero.secondaryHref}>
                {hero.secondaryCta}
              </a>
            </HoverLift>
          </div>
        </div>
        <QuoteCard />
      </div>
    </HeroReveal>
  </div>
</section>
