---
import { principles } from "../data/copy";
import { BentoPrinciples } from "./react/BentoPrinciples";
---

<section id="principles" class="border-t border-slate-200/80 bg-slate-50/50 relative overflow-hidden" aria-labelledby="principles-heading">
  <div class="shell section relative">
    <div class="max-w-3xl mb-12 text-center mx-auto">
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full">
        Validation Pillars
      </span>
      <h2
        id="principles-heading"
        class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900"
      >
        {principles.title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Key architectural principles guiding our research and technical-validation discussions.
      </p>
    </div>

    <BentoPrinciples client:visible />
  </div>
</section>
