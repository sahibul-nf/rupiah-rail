---
import { site, terms } from "../data/copy";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`${terms.title} — ${site.name}`} description={terms.description} currentPath="/terms">
  <article class="shell section">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight text-ink">{terms.title}</h1>
      <div class="mt-8 space-y-4 text-ink-muted">
        {terms.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </article>
</BaseLayout>
